# ─── AI ───────────────────────────────────────────────
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.1-flash-lite

# Optional: automatic failover when Gemini quota runs out.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── SMS (MSG91) ──────────────────────────────────────
# Set SMS_ENABLED=true and fill the keys to send real OTPs.
# Sign up: https://msg91.com  →  Auth Key from the dashboard,
# Template ID from the OTP template you create (needs DLT approval in India).
SMS_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=CIVCAI
SMS_COUNTRY_CODE=91

# ─── Email (Resend) ───────────────────────────────────
# Set EMAIL_ENABLED=true and add a key from https://resend.com
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=CivicAI <onboarding@resend.dev>

# ─── Sign in with Google ──────────────────────────────
# Create an OAuth Client ID (Web application) at:
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 under "Authorized JavaScript origins".
# Same value goes in both vars below (one read by the server, one by the browser build).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ─── Auth ─────────────────────────────────────────────
# Echoes the OTP in the API response so the demo works without a gateway.
# MUST be false in production.
AUTH_DEV_OTP=true

PORT=8787
