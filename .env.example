# ─── AI ───────────────────────────────────────────────
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.1-flash-lite

# Optional: automatic failover when Gemini quota runs out.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── AWS Bedrock (optional, first fallback) ───────────
# Long-term API key from the Bedrock console → API keys.
# Treat this like a password: it grants billable model access on your AWS
# account. Never commit it, never paste it into a screenshot or chat.
# Requires model access to be granted for BEDROCK_MODEL_ID in that region.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ─── Database (Neon Postgres) ─────────────────────────
# Without this the app uses a non-durable in-memory store and the admin
# portal shows a warning banner. Create a project at https://neon.tech,
# copy the POOLED connection string, then:
#   npm install @neondatabase/serverless
DATABASE_URL=

# ─── Admin access ─────────────────────────────────────
# Grants super_admin to this signed-in address. Without it, no session
# receives admin access (deny by default).
# Either grants super_admin. Email matches a Google sign-in;
# phone matches an SMS OTP sign-in. 10 digits or +91 both work.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=

# ─── Sessions (REQUIRED) ──────────────────────────────
# Signs the stateless session cookie. MUST be >= 32 random characters.
# The server refuses to boot in production without it.
#   generate with:  openssl rand -base64 48
SESSION_SECRET=

# ─── Sign in with Google (primary auth) ───────────────
# Create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include http://localhost:3000
# The same value goes in both vars (server verifies, browser renders).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ─── Email OTP (fallback auth, via Resend) ────────────
# Set EMAIL_ENABLED=true and add a key from https://resend.com
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=CivicAI <onboarding@resend.dev>

# ─── Bot protection (optional) ────────────────────────
# Without a secret, a honeypot + form-timing heuristic is used.
# Add a Cloudflare Turnstile secret to enable full CAPTCHA verification.
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# ─── Auth / dev ───────────────────────────────────────
# Echoes the OTP in the API response so the demo works without an email
# gateway. Ignored when NODE_ENV=production. MUST be false in production.
AUTH_DEV_OTP=true

PORT=8787

# NOTE: phone/SMS (MSG91) auth was removed. Sign-in is Google + email OTP.

# ═══════════════════════════════════════════════════════════════════
# INTEGRATION FLAGS
# ═══════════════════════════════════════════════════════════════════
# Every flag defaults ON, so a fresh clone is fully usable. Set one to
# false to switch that surface off entirely (it renders as "Off", not as
# broken).
ENABLE_AI=true
ENABLE_OCR=true
ENABLE_VOICE=true
ENABLE_WHATSAPP=true
ENABLE_SMS=true
ENABLE_DIGILOCKER=true
ENABLE_GOOGLE_OAUTH=true
ENABLE_DOCUMENT_VERIFICATION=true

# Demo Mode decides what happens when a credential is MISSING: simulate the
# provider (true) or refuse and report "configuration required" (false).
# Defaults to true outside production and false inside it. A production
# deploy that wants simulated providers must opt in explicitly.
# Simulated providers are always labelled as such in the UI.
ENABLE_DEMO_MODE=

# ─── WhatsApp Cloud API (Meta) ────────────────────────
# All three are required before WhatsApp reports "Live". Create an app at
# https://developers.facebook.com → WhatsApp → API Setup.
# WHATSAPP_VERIFY_TOKEN is a string you invent; paste the same value into
# the Meta webhook configuration screen.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Used to verify the X-Hub-Signature-256 header on incoming webhooks.
# Found under App Settings → Basic → App Secret.
WHATSAPP_APP_SECRET=

# ─── DigiLocker ───────────────────────────────────────
# Requires an approved partner account with MeitY. Without these the
# authorisation flow is SIMULATED and labelled "Demo" everywhere it appears.
# CivicAI never asks a citizen for their DigiLocker password.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# ─── Public base URL ──────────────────────────────────
# Used to build webhook and OAuth callback URLs. No localhost in production.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Notification channels ────────────────────────────
# Every outbound channel is OFF by default for each citizen and must be
# switched on by them. In-app is always on and cannot be disabled — it is
# the record of their own complaint, not a message pushed at them.
#
# WhatsApp note: Meta only permits FREEFORM messages within 24 hours of the
# citizen's last inbound message. Outside that window only pre-approved
# templates may be sent. The template names this code expects are:
#   complaint_registered, officer_assigned, information_required,
#   complaint_resolved
# Create and get them approved in the Meta dashboard before going live.
